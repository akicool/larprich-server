# Reference list of the variables the production stack needs. These are NOT kept
# in a file on the server — paste them into the Dokploy service's Environment
# tab, which Dokploy materialises as the .env next to docker-compose.prod.yml at
# deploy time. That is what resolves every ${...} in that compose file.
#
# PORT and NODE_ENV are not here on purpose: they are fixed in the compose file.

CORS_ORIGIN=*
SEARCH_TIMEOUT_MS=50000
HEARTBEAT_INTERVAL_MS=15000
LOG_LEVEL=log

# Public hostname. Traefik gets the Let's Encrypt cert for it (configured in the
# service's Domains tab, not here), and coturn uses it as its realm.
DOMAIN_NAME=larprich.serkilov.com

# STUN/TURN URLs handed to clients in the `matched` message.
STUN_URLS=stun:stun.l.google.com:19302,stun:larprich.serkilov.com:3478
TURN_URLS=turn:larprich.serkilov.com:3478?transport=udp,turn:larprich.serkilov.com:3478?transport=tcp

# Generate with `npm run turn:secret`. The app derives time-limited TURN
# credentials from it, and coturn is started with the same value via
# --static-auth-secret — so it is set in exactly one place.
TURN_SHARED_SECRET=CHANGE_ME_GENERATE_WITH_npm_run_turn_secret
TURN_CREDENTIAL_TTL_SECONDS=3600
