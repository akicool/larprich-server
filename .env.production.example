# Variables for the Dokploy service's Environment tab (Dokploy materialises them
# as the .env next to docker-compose.prod.yml at deploy time, which is what
# resolves the ${...} in that file).
#
# Only ONE value is actually required:
#
#   TURN_SHARED_SECRET=<output of `npm run turn:secret`>
#
# Everything below is optional — the compose file carries the same defaults, so
# a deploy with only the secret set comes up correctly. Set a variable here only
# to override that default.
#
# STUN_URLS and TURN_URLS are deliberately absent: they are derived from
# DOMAIN_NAME inside the compose file so they cannot drift out of sync with what
# coturn actually serves.

# DOMAIN_NAME=larprich.serkilov.com
# CORS_ORIGIN=*
# SEARCH_TIMEOUT_MS=50000
# HEARTBEAT_INTERVAL_MS=15000
# LOG_LEVEL=log
# TURN_CREDENTIAL_TTL_SECONDS=3600
